LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=
OPENAI_TEMPERATURE=0.1

# Embedder
EMBED_CHUNK_TOKENS=400
EMBED_CHUNK_OVERLAP=80
EMBED_MODEL=text-embedding-3-small

# 기타
UPLOAD_DIR=uploads
WHISPER_MODEL=tiny
WHISPER_URL=http://workmaite-whisper:9000

# R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# Neo4j (kubectl port-forward svc/workmaite-neo4j 7474:7474 7687:7687)
NEO4J_URL=http://localhost:7474
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=
NEO4J_RETRY_INTERVAL_SEC=300

JWT_SECRET=
INTERNAL_SECRET=

# PostgreSQL (kubectl port-forward svc/postgres-1-postgresql 5432:5432 -n postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=