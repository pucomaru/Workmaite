LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=

# OpenAI 설정. Key, 서버 기본 Model
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# STT 설정
STT_MODEL=gpt-4o-transcribe-diarize
# 실시간 전사(P5) 모델 — gpt-4o-transcribe / gpt-4o-mini-transcribe / gpt-realtime-whisper
STT_REALTIME_MODEL=gpt-4o-transcribe

# Embedder
EMBED_MODEL=text-embedding-3-large
EMBED_CHUNK_TOKENS=400
EMBED_CHUNK_OVERLAP=80

# 기타
UPLOAD_DIR=uploads
WHISPER_MODEL=tiny
WHISPER_URL=http://workmaite-whisper:9000


# R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# Neo4j — Bolt 프로토콜 사용 (kubectl port-forward svc/workmaite-neo4j 7687:7687)
# 브라우저는 7474(HTTP)로 별도 접속. http://...:7474 로 줘도 자동으로 bolt://...:7687 로 변환됨.
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=
NEO4J_RETRY_INTERVAL_SEC=300

JWT_SECRET=
INTERNAL_SECRET=

# PostgreSQL (kubectl port-forward svc/postgres-1-postgresql 5432:5432 -n postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=