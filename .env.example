LOG_LEVEL=info

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=


# OpenAI 설정. Key, 서버 기본 Model
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# STT 설정
# 실시간 전사(P5) 모델 — gpt-realtime-whisper / gpt-4o-transcribe / gpt-4o-mini-transcribe
STT_MODEL=gpt-realtime-whisper

# Embedder
EMBED_MODEL=text-embedding-3-small
# EMBED_DIM은 모델에서 자동 도출(3-small/ada-002=1536, 3-large=3072). 축소 차원을 쓰려면 명시:
# EMBED_DIM=1536
EMBED_CHUNK_TOKENS=400
EMBED_CHUNK_OVERLAP=80

# 기타
UPLOAD_DIR=uploads

# R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# Neo4j — 7687 포트 Bolt 프로토콜 사용 (kubectl port-forward svc/workmaite-neo4j 7687:7687)
# 브라우저는 7474 포트 HTTP로 접속
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=
# 주기적 전체 재동기화(PG→Neo4j, orphan 정리) 주기(초) — 백그라운드 태스크. 기본 1800(30분).
RESYNC_INTERVAL_SEC=1800
STARTUP_FULL_RESYNC=false


JWT_SECRET=
INTERNAL_SECRET=

# PostgreSQL (kubectl port-forward svc/postgres-1-postgresql 5432:5432 -n postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=